# ── Environment variables for signal-service ─────────────────────────────
# Copy this file to signal-service/.env and fill in your values.

# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=production

# Port to listen on.
# Production default: 443 (HTTPS). Use 3001 for dev.
PORT=443

# ── mediasoup ────────────────────────────────────────────────────────────
# The IP mediasoup workers bind to (keep 0.0.0.0 unless you know better)
MEDIASOUP_LISTEN_IP=0.0.0.0

# ⚠️  IMPORTANT: Set this to your Oracle VM's PUBLIC IP address.
# This is what mediasoup tells browsers to connect to for WebRTC media.
# Wrong value = black video screens.
MEDIASOUP_ANNOUNCED_IP=YOUR_ORACLE_VM_PUBLIC_IP

# ── SSL (HTTPS) ───────────────────────────────────────────────────────────
# Paths to Let's Encrypt cert files (from Certbot).
# Run: sudo certbot certonly --standalone -d yourdomain.com
SSL_CERT=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY=/etc/letsencrypt/live/yourdomain.com/privkey.pem
